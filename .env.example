# Optional. Ersteinrichtung und Zugangsdaten ausschließlich über den Browser.
# Kein Passwort und keine persönliche Geräteadresse in dieser Datei nötig.
HTTP_BIND=0.0.0.0
HTTP_PORT=8088
COOKIE_SECURE=false
DEMO_MODE=false

# Container-Plattform: leer = automatisch die des Hosts.
# Sonst linux/amd64 (Intel/AMD) oder linux/arm64 (ARM64). tools/setup.py fragt das ab.
KILOWATCH_PLATFORM=

# Nur für compose.prebuilt.yaml: leer = neueste 1.x-Version, sonst feste Version wie 1.2.3.
KILOWATCH_VERSION=

# Eigentümer der Dateien in ./data. Auf Synology einen DSM-Benutzer mit Lese-/Schreibrecht
# auf den Ordner data eintragen (SSH: id <benutzer>), z. B. 1030 und 100. Leer = 10001.
PUID=
PGID=

# Nur für den optionalen lokalen MQTT-Broker; kein statisches NAS-IP-Binding.
MQTT_BIND=0.0.0.0
MQTT_PORT=1883
