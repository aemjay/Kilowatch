# Optional. Ersteinrichtung und Zugangsdaten ausschließlich über den Browser.
# Kein Passwort und keine persönliche Geräteadresse in dieser Datei nötig.
HTTP_BIND=0.0.0.0
HTTP_PORT=8088
COOKIE_SECURE=false
DEMO_MODE=false

# Container-Plattform: leer = automatisch die des Hosts.
# Sonst linux/amd64 (Intel/AMD) oder linux/arm64 (ARM64).
KILOWATCH_PLATFORM=

# Nur für compose.yaml: leer = neueste 1.x-Version, sonst feste Version wie 1.2.3.
KILOWATCH_VERSION=

# tools/update.sh prüft die Image-Signatur (cosign) und brechen ohne gültige
# Signatur ab. 0 schaltet das ab, z. B. für ein selbst gebautes Image (nicht empfohlen).
KILOWATCH_VERIFY=1

# Benutzer, unter dem Kilowatch läuft. Leer = automatisch der Eigentümer des Ordners data
# (wer ihn in der File Station anlegt). Nur bei Bedarf eine DSM-Benutzer-ID eintragen (SSH: id <benutzer>).
PUID=
PGID=

# Nur für den optionalen lokalen MQTT-Broker; kein statisches NAS-IP-Binding.
MQTT_BIND=0.0.0.0
MQTT_PORT=1883
